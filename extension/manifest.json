{
  "manifest_version": 3,
  "name": "Vision-Laya · AI Browser Co-Pilot",
  "version": "1.3.0",
  "description": "Universal Visual Browser Agent with Vision-Laya (99ms) & multi-frame OOPIF perception. Interactive chat, canvas hit-testing, and live execution steps.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Open Jev Assist",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "tabGroups",
    "storage",
    "debugger",
    "sidePanel",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ]
}
