{
  "manifest_version": 3,
  "name": "Jev Assist · AI Browser Co-Pilot",
  "version": "1.2.0",
  "description": "Drive Brave or Chrome with local distilled Laya (75ms) + Vision fallback. Interactive chat, document checklists, and live execution steps.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Open Jev Assist",
    "default_icon": "icon.png",
    "default_popup": "sidepanel.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ]
}
