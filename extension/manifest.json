{
  "manifest_version": 3,
  "name": "Jev Assist · AI Browser Co-Pilot",
  "version": "1.1.0",
  "description": "Drives the tab you are on in your own Brave or Chrome. Local decisions, vision fallback, asks you before anything sensitive.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Open Jev Assist",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ]
}
